[terra]
name=Terra $releasever
#baseurl=https://repos.fyralabs.com/terra$releasever
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever
# Terra currently uses a CDN based on the origin repo, so this is safe
repo_gpgcheck=0
enabled=1
enabled_metadata=1
countme=1

[terra-source]
name=Terra $releasever - Source
#baseurl=https://repos.fyralabs.com/terra$releasever-source
metalink=https://tetsudou.fyralabs.com/metalink?repo=terra$releasever-source&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///usr/share/pki/rpm-gpg/RPM-GPG-KEY-terra$releasever-source
# Terra currently uses a CDN based on the origin repo, so this is safe
repo_gpgcheck=0
enabled=0
enabled_metadata=0
